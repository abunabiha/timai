# TimAI Environment Configuration Example

# Application
APP_NAME="TimAI Platform"
APP_ENV=development
APP_VERSION=1.0.0

# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=timai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/timai
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/timai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security (Replace with random strings in production)
SECRET_KEY=timai-insecure-secret-key-change-me
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3001
